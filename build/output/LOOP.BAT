@echo off
REM ============================================================
REM Build script for LOOP
REM Generated by DosNET Compiler
REM Target: HX DOS Extender (32-bit Protected Mode)
REM ============================================================

REM ============================================================
REM Configure paths (JWASM + JWLINK)
REM ============================================================
SET JWASM_PATH=C:\JWASM
SET ASM=%JWASM_PATH%\JWASMR.EXE
SET LINK=%JWASM_PATH%\JWLINKD.EXE
SET LIB=%JWASM_PATH%\JWLIBD.EXE

SET HX_PATH=C:\HX

REM ============================================================
REM Building HX DOS Extender Application
REM ============================================================

echo [1/2] Assembling LOOP.ASM...
"%ASM%" LOOP.ASM
if errorlevel 1 goto error

echo [2/3] Linking LOOP.EXE...
REM Link with CORLIB.OBJ and HX libraries using JWLINK (PE format)
"%LINK%" format windows pe file LOOP.OBJ,CORLIB.OBJ library %HX_PATH%\LIB\DKRNL32S.LIB library %HX_PATH%\LIB\LIBC32S.LIB library %HX_PATH%\LIB\IMPHLP.LIB name LOOP.EXE
if errorlevel 1 goto error

echo [3/3] Adding HX DOS stub...
REM Add HX DOS stub with embedded DPMI loader for standalone execution
%HX_PATH%\BIN\PESTUB.EXE LOOP.EXE %HX_PATH%\BIN\DPMIST32.BIN
if errorlevel 1 goto error

echo.
echo ============================================================
echo Build successful!
echo ============================================================
echo Output:     LOOP.EXE
echo Heap size:  64 KB (0 MB)
echo Stack size: 64 KB
echo.
echo To run in DOS:
echo   1. Copy LOOP.EXE and HDPMI32.EXE to DOS
echo   2. Run: LOOP.EXE
echo.
echo To run in Windows:
echo   Just run: LOOP.EXE
goto end

:error
echo.
echo ============================================================
echo BUILD FAILED!
echo ============================================================
echo Check the error messages above.
echo.
echo Common issues:
echo   - MASM32 not installed or path incorrect
echo   - HX DOS Extender not installed or path incorrect
echo   - corlib.lib not found (build corlib first)
exit /b 1

:end
