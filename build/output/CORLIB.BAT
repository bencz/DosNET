@echo off
REM ============================================================
REM Build script for CORLIB
REM Generated by DosNET Compiler
REM Target: HX DOS Extender (32-bit Protected Mode)
REM ============================================================

REM ============================================================
REM Configure paths (JWASM + JWLINK)
REM ============================================================
SET JWASM_PATH=C:\JWASM
SET ASM=%JWASM_PATH%\JWASMR.EXE
SET LINK=%JWASM_PATH%\JWLINKD.EXE
SET LIB=%JWASM_PATH%\JWLIBD.EXE

SET HX_PATH=C:\HX

REM ============================================================
REM Building corlib.lib (DosNET Base Class Library)
REM ============================================================

echo [1/2] Assembling CORLIB.ASM...
"%ASM%" CORLIB.ASM
if errorlevel 1 goto error

echo [2/2] Creating CORLIB.LIB...
"%LIB%" -n -b CORLIB.LIB +CORLIB.OBJ
if errorlevel 1 goto error

echo.
echo ============================================================
echo Build successful!
echo ============================================================
echo Output: CORLIB.LIB
echo.
echo To use this library, copy it to your project directory
echo and link with your application.
goto end

:error
echo.
echo ============================================================
echo BUILD FAILED!
echo ============================================================
echo Check the error messages above.
echo.
echo Common issues:
echo   - MASM32 not installed or path incorrect
echo   - HX DOS Extender not installed or path incorrect
echo   - corlib.lib not found (build corlib first)
exit /b 1

:end
