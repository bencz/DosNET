
# WLINK format definition for HX: hxnt, hxnts, hxdos, hxdosr. 

system begin hxnt
    option osname='HX Extender (Win32 PE)'
    libpath %WATCOM%/lib386
    libpath %WATCOM%/lib386/nt
    library kernel32,user32,advapi32,ole32,oleaut32
    format windows nt ^
    op stub=dpmist32.bin
    runtime console=4.0
end

# the next formats require to run patchPE after wlink step!!!
# all MZ stubs supplied with HX will work, but LOADPE.BIN and DPMILD32.BIN
# are the recommended ones. The latter is significantly larger, but supports
# loading PE dlls in DOS.

# DOS PE binary format with Win32 CRT and Win32 linked statically
# stack must be at least 128 kB because of OW peculiarities

system begin hxnts
    option osname='HX Extender (DOS PE, static Win32)'
    libpath %WATCOM%/lib386
    libpath %WATCOM%/lib386/nt
    libpath /hx/lib
    libfile initw3ow.obj
    disable 1030
    op stack=0x40000
    library imphlp,dkrnl32s,duser32s
    op stub=loadpe.bin
    format windows nt ^
    runtime console=4.0
end

# DOS PE binary format with OW's DOS32P CRT.
# system hxdos  is for "stack calling convention" (-3s, -4s, -5s )
# system hxdosr is for "Watcom register calling convention (-3r, -4r, -5r)
# lib HXOWx.lib contains the spawn() function

system begin hxdos
    option osname='HX Extender (DOS PE, stack calling conv.)'
    libpath %WATCOM%/lib386
    libpath %WATCOM%/lib386/dos
    library hxows
    libfile cstrtdhx.obj
    op stub=loadpe.bin
    format windows nt ^
    runtime console=4.0
end

system begin hxdosr
    option osname='HX Extender (DOS PE, register calling conv.)'
    libpath %WATCOM%/lib386
    libpath %WATCOM%/lib386/dos
    library hxowr
    libfile cstrtdhr.obj
    op stub=loadpe.bin
    format windows nt ^
    runtime console=4.0
end
