00000000  000000000000000000    palette         dd      256 dup (?)
00000400  000000000000000000    table           dd      512 dup (?)

00000000                            .DATA

 = 280                          ddwidth         EQU     640     ; display mode width
 = 1E0                          ddheight        EQU     480     ; display mode height
00000000  04000000              dwBytesPixel	dd      4

00000004  FFFFFFFF              dwMode          dd      -1
                                if ?BACKBUFFER
00000008  00000000              dwScreenSize    dd      0
0000000C  00000000              dwScreenOffs    dd      0
00000010  01                    bFlip           db      1
                                endif
00000011  00000000              phaseA          dd      0
00000015  00000000              phaseB          dd      0

 = FFFFFFFF                     factor1         EQU     -1
 = 1                            factor2         EQU     1
 = 1                            factor3         EQU     1
 = FFFFFFFF                     factor4         EQU     -1

00000019  00009643              red             REAL4   300.0
0000001D  0000A043              green           REAL4   320.0
00000021  0000AA43              blue            REAL4   340.0

00000025  00000040              scale1          REAL4   2.0
