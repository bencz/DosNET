                                ;-----------------------------------------------------------;
                                ;                Calculate Next Plasma Frame                ;
                                ;-----------------------------------------------------------;

00000000                        nextFrame   PROC uses ebx esi edi ebp

00000004  B9E0010000                mov     ecx, ddheight           ; # of scanlines
00000009  8B3D59000000              mov     edi, svgainfo.PhysBasePtr
                                if ?BACKBUFFER
0000000F  033D0C000000              add     edi, dwScreenOffs
                                endif
00000015  8B2D00000000              mov     ebp, dwBytesPixel 
0000001B                        @@scanline:
0000001B  51                        push    ecx
0000001C  57                        push    edi

0000001D  8B3511000000              mov     esi, [phaseA]
00000023  8B1515000000              mov     edx, [phaseB]
00000029  2BF1                      sub     esi, ecx
0000002B  81E2FF000000              and     edx, 0FFh
00000031  81E6FF000000              and     esi, 0FFh
00000037  8B149500080000            mov     edx, [table][4*edx][256*4]
0000003E  8B34B500040000            mov     esi, [table][4*esi]     ; [x]  +  table0[a + y]
00000045  2BD1                      sub     edx, ecx                ; [y]  +  table1[b]
00000047  B980020000                mov     ecx, ddwidth            ; [x] --> pixel counter

0000004C                        @@pixel:
0000004C  81E6FF000000              and     esi, 0FFh
00000052  81E2FF000000              and     edx, 0FFh
00000058  8B04B500040000            mov     eax, [table][4*esi]
0000005F  8B1C9500080000            mov     ebx, [table][4*edx][256*4]
00000066  03C3                      add     eax, ebx
00000068  83C601                    add     esi, factor3
0000006B  D1E8                      shr     eax, 1
0000006D  83C2FF                    add     edx, factor4
00000070  25FF000000                and     eax, 0FFh
00000075  03FD                      add     edi, ebp
00000077  8B048500000000            mov     eax, [palette][4*eax]
0000007E  83FD04                    cmp     ebp, 4
00000081  7509                      jnz     @F
00000083  658947FC                  mov     gs:[edi-4], eax
00000087  49                        dec     ecx
00000088  75C2                      jnz     @@pixel
0000008A  EB0F                      jmp     done
0000008C                        @@:    
0000008C  66658947FD                mov     gs:[edi-3], ax
00000091  C1E808                    shr     eax,8
00000094  658867FF                  mov     gs:[edi-1], ah
00000098  49                        dec     ecx
00000099  75B1                      jnz     @@pixel
0000009B                        done:
0000009B  5F                        pop     edi
0000009C  59                        pop     ecx
0000009D  0FB70541000000            movzx   eax, svgainfo.BytesPerScanLine
000000A4  03F8                      add     edi, eax                        ; inc. display position
000000A6  49                        dec     ecx
000000A7  0F856EFFFFFF              jnz     @@scanline

000000AD  830511000000FF            add     [phaseA], factor1
000000B4  83051500000001            add     [phaseB], factor2

000000BB                            ret
000000C0                        nextFrame   ENDP


                                ;-----------------------------------------------------------;
                                ;                Initalize Plasma Tables                    ;
                                ;-----------------------------------------------------------;

000000C0                        initPlasma  PROC

                                    LOCAL @@i :DWORD
                                    LOCAL @@r :DWORD
                                    LOCAL @@g :DWORD
                                    LOCAL @@b :DWORD
                                    LOCAL temp :DWORD

000000C6  C745FC00000000            mov     [@@i], 0

000000CD                            .WHILE @@i < 256

000000D2  8B55FC                        mov     edx, [@@i]

                                ; Calculate table0 value

000000D5  D9EB                          fldpi
000000D7  DA4DFC                        fimul   [@@i]
000000DA  D80D25000000                  fmul    [scale1]
000000E0  D8352D000000                  fdiv    [scale3]
000000E6  D9FE                          fsin
000000E8  D80D29000000                  fmul    [scale2]
000000EE  D80529000000                  fadd    [scale2]
000000F4  DB1C9500040000                fistp   [table][4*edx]

                                ; Calculate table1 value

000000FB  D9EB                          fldpi
000000FD  DA4DFC                        fimul   [@@i]
00000100  D80D25000000                  fmul    [scale1]
00000106  D8352D000000                  fdiv    [scale3]
0000010C  D9FF                          fcos
0000010E  D80D29000000                  fmul    [scale2]
00000114  D80529000000                  fadd    [scale2]
0000011A  D9EB                          fldpi
0000011C  DEC9                          fmulp   st(1), st
0000011E  D80D25000000                  fmul    [scale1]
00000124  D8352D000000                  fdiv    [scale3]
0000012A  D9FE                          fsin
0000012C  D80D29000000                  fmul    [scale2]
00000132  D80529000000                  fadd    [scale2]
00000138  DB1C9500080000                fistp   [table][4*edx][4*256]

                                ; Calculate palette value

0000013F  33C0                          xor     eax, eax

                                        FOR comp, <red, green, blue>
 >                                          fldpi
 >                                          fimul   [@@i]
 >                                          fmul    [scale1]
 >                                          fdiv    [comp]
 >                                          fcos
 >                                          fmul    [scale2]
 >                                          fadd    [scale2]
 >                                          fistp   [temp]
 >                                          shl     eax, 8
 >                                          or      eax, [temp]
 >                                      ENDM
00000141  D9EB               1              fldpi
00000143  DA4DFC             1              fimul   [@@i]
00000146  D80D25000000       1              fmul    [scale1]
0000014C  D83519000000       1              fdiv    [red]
00000152  D9FF               1              fcos
00000154  D80D29000000       1              fmul    [scale2]
0000015A  D80529000000       1              fadd    [scale2]
00000160  DB5DEC             1              fistp   [temp]
00000163  C1E008             1              shl     eax, 8
00000166  0B45EC             1              or      eax, [temp]
00000169  D9EB               1              fldpi
0000016B  DA4DFC             1              fimul   [@@i]
0000016E  D80D25000000       1              fmul    [scale1]
00000174  D8351D000000       1              fdiv    [green]
0000017A  D9FF               1              fcos
0000017C  D80D29000000       1              fmul    [scale2]
00000182  D80529000000       1              fadd    [scale2]
00000188  DB5DEC             1              fistp   [temp]
0000018B  C1E008             1              shl     eax, 8
0000018E  0B45EC             1              or      eax, [temp]
00000191  D9EB               1              fldpi
00000193  DA4DFC             1              fimul   [@@i]
00000196  D80D25000000       1              fmul    [scale1]
0000019C  D83521000000       1              fdiv    [blue]
000001A2  D9FF               1              fcos
000001A4  D80D29000000       1              fmul    [scale2]
000001AA  D80529000000       1              fadd    [scale2]
000001B0  DB5DEC             1              fistp   [temp]
000001B3  C1E008             1              shl     eax, 8
000001B6  0B45EC             1              or      eax, [temp]

000001B9  89049500000000                mov     [palette][4*edx] , eax
000001C0  FF45FC                        inc     [@@i]

000001C3                            .ENDW

000001D0                            ret
000001D4                        initPlasma  ENDP

