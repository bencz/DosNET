                                RETURN  MACRO   arg
 >                                  IFNB <arg>
 >                                      mov     eax, arg
 >                                  ENDIF
 >                                  ret
 >                              ENDM

                                LRETURN MACRO   arg 
 >                                  IFNB <arg>
 >                                      mov     eax, arg
 >                                  ENDIF
 >                                  leave
 >                                  ret
 >                              ENDM

                                FATAL   MACRO   msg
