@ECHO OFF
ECHO Testing Fibonacci with proper stub... > LOG.TXT

DEL FIBONACI.OBJ 2>NUL
DEL FIBONACI.EXE 2>NUL
DEL FIBONACI.BAK 2>NUL

ECHO [1/3] Assembling... >> LOG.TXT
C:\JWASM\JWASMR.EXE FIBONACI.ASM >> LOG.TXT
IF NOT EXIST FIBONACI.OBJ GOTO ERROR

ECHO [2/3] Linking... >> LOG.TXT
C:\JWASM\JWLINKD.EXE format windows pe file FIBONACI.OBJ,CORLIB.OBJ name FIBONACI.EXE >> LOG.TXT
IF NOT EXIST FIBONACI.EXE GOTO ERROR

ECHO [3/3] Adding HX stub... >> LOG.TXT
C:\HX\BIN\PESTUB.EXE FIBONACI.EXE C:\HX\BIN\DPMIST32.BIN >> LOG.TXT

ECHO. >> LOG.TXT
ECHO Running with DPMILD32... >> LOG.TXT
C:\HX\BIN\DPMILD32.EXE FIBONACI.EXE > RESULT.TXT
TYPE RESULT.TXT >> LOG.TXT

ECHO. >> LOG.TXT
ECHO Running directly... >> LOG.TXT
FIBONACI.EXE > RESULT2.TXT
TYPE RESULT2.TXT >> LOG.TXT

GOTO END

:ERROR
ECHO BUILD FAILED! >> LOG.TXT

:END
