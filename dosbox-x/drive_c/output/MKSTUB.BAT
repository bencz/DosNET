@ECHO OFF
ECHO Adding HX stub to HELLOWLD.EXE... > LOG.TXT

REM Use PESTUB with DPMIST32.BIN to embed the loader
C:\HX\BIN\PESTUB.EXE HELLOWLD.EXE C:\HX\BIN\DPMIST32.BIN >> LOG.TXT

ECHO Done! >> LOG.TXT
DIR HELLOWLD.EXE >> LOG.TXT

ECHO. >> LOG.TXT
ECHO Testing direct execution... >> LOG.TXT
DEL RESULT.TXT 2>NUL
HELLOWLD.EXE > RESULT.TXT
IF EXIST RESULT.TXT TYPE RESULT.TXT >> LOG.TXT
