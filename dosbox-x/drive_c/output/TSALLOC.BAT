@ECHO OFF
ECHO ======================================== > LOG.TXT
ECHO Building TestSimpleAlloc >> LOG.TXT
ECHO ======================================== >> LOG.TXT

DEL *.OBJ 2>NUL
DEL *.EXE 2>NUL
DEL *.BAK 2>NUL

ECHO [1/4] Assembling CORLIB... >> LOG.TXT
C:\JWASM\JWASMR.EXE CORLIB.ASM >> LOG.TXT
IF NOT EXIST CORLIB.OBJ GOTO ERROR

ECHO [2/4] Assembling TSALLOC... >> LOG.TXT
C:\JWASM\JWASMR.EXE TSALLOC.ASM >> LOG.TXT
IF NOT EXIST TSALLOC.OBJ GOTO ERROR

ECHO [3/4] Linking... >> LOG.TXT
C:\JWASM\JWLINKD.EXE format windows pe runtime console file TSALLOC.OBJ,CORLIB.OBJ name TSALLOC.EXE >> LOG.TXT
IF NOT EXIST TSALLOC.EXE GOTO ERROR

ECHO [4/4] Adding stub... >> LOG.TXT
C:\HX\BIN\PESTUB.EXE TSALLOC.EXE C:\HX\BIN\DPMIST32.BIN >> LOG.TXT

ECHO. >> LOG.TXT
ECHO Running TestSimpleAlloc... >> LOG.TXT
TSALLOC.EXE > RESULT.TXT
TYPE RESULT.TXT >> LOG.TXT
GOTO END

:ERROR
ECHO BUILD FAILED! >> LOG.TXT

:END
