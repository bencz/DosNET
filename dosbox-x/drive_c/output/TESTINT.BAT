@ECHO OFF
ECHO ======================================== > LOG.TXT
ECHO Building SimpleInt >> LOG.TXT
ECHO ======================================== >> LOG.TXT

DEL *.OBJ 2>NUL
DEL *.EXE 2>NUL
DEL *.BAK 2>NUL

ECHO [1/4] Assembling CORLIB... >> LOG.TXT
C:\JWASM\JWASMR.EXE CORLIB.ASM >> LOG.TXT
IF NOT EXIST CORLIB.OBJ GOTO ERROR

ECHO [2/4] Assembling SIMPLENT... >> LOG.TXT
C:\JWASM\JWASMR.EXE SIMPLENT.ASM >> LOG.TXT
IF NOT EXIST SIMPLENT.OBJ GOTO ERROR

ECHO [3/4] Linking... >> LOG.TXT
C:\JWASM\JWLINKD.EXE format windows pe file SIMPLENT.OBJ,CORLIB.OBJ name SIMPLENT.EXE >> LOG.TXT
IF NOT EXIST SIMPLENT.EXE GOTO ERROR

ECHO [4/4] Adding stub... >> LOG.TXT
C:\HX\BIN\PESTUB.EXE SIMPLENT.EXE C:\HX\BIN\DPMIST32.BIN >> LOG.TXT

ECHO. >> LOG.TXT
ECHO Running SimpleInt... >> LOG.TXT
SIMPLENT.EXE > RESULT.TXT
TYPE RESULT.TXT >> LOG.TXT
GOTO END

:ERROR
ECHO BUILD FAILED! >> LOG.TXT

:END
