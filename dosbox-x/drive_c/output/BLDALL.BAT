@ECHO OFF
ECHO ======================================== > LOG.TXT
ECHO Building CORLIB and Fibonacci >> LOG.TXT
ECHO ======================================== >> LOG.TXT

DEL *.OBJ 2>NUL
DEL *.EXE 2>NUL
DEL *.BAK 2>NUL

ECHO [1/5] Assembling CORLIB... >> LOG.TXT
C:\JWASM\JWASMR.EXE CORLIB.ASM >> LOG.TXT
IF NOT EXIST CORLIB.OBJ GOTO ERROR

ECHO [2/5] Assembling FIBONACI... >> LOG.TXT
C:\JWASM\JWASMR.EXE FIBONACI.ASM >> LOG.TXT
IF NOT EXIST FIBONACI.OBJ GOTO ERROR

ECHO [3/5] Linking FIBONACI.EXE... >> LOG.TXT
C:\JWASM\JWLINKD.EXE format windows pe file FIBONACI.OBJ,CORLIB.OBJ name FIBONACI.EXE >> LOG.TXT
IF NOT EXIST FIBONACI.EXE GOTO ERROR

ECHO [4/5] Adding stub... >> LOG.TXT
C:\HX\BIN\PESTUB.EXE FIBONACI.EXE C:\HX\BIN\DPMIST32.BIN >> LOG.TXT

ECHO [5/5] Running... >> LOG.TXT
FIBONACI.EXE > RESULT.TXT
TYPE RESULT.TXT >> LOG.TXT
GOTO END

:ERROR
ECHO BUILD FAILED! >> LOG.TXT

:END
